                  "pm.test('Requiere JWT y responde HTTP 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/events/{{fixtureEventId}}/participants"
