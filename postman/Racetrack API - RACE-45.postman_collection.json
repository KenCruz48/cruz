        {
          "name": "POST Crear evento como organizador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Crea evento autenticado con HTTP 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Guarda el ID del evento nuevo', function () { const body = pm.response.json(); pm.expect(body.status).to.eql('success'); pm.expect(body.data.name).to.eql(pm.environment.get('eventName')); pm.expect(body.data.id).to.be.a('string').and.not.empty; pm.environment.set('eventId', body.data.id); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{eventName}}\",\n  \"date\": \"2099-06-15T09:00:00.000Z\",\n  \"location\": \"Pista Newman\",\n  \"distance\": 5,\n  \"capacity\": 100\n}"
            },
            "url": "{{baseUrl}}/api/v1/events"
          },
          "response": []
        },
        {
          "name": "GET Participantes con JWT del organizador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Permite al organizador consultar participantes con HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve una lista de participantes', function () { const body = pm.response.json(); pm.expect(body.status).to.eql('success'); pm.expect(body.data).to.have.property('participants'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/events/{{eventId}}/participants"
          },
          "response": []
        },
        {
          "name": "PATCH Actualizar evento como organizador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Actualiza el evento autenticado con HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve el nuevo nombre', function () { pm.expect(pm.response.json().data.name).to.eql(pm.environment.get('updatedEventName')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{updatedEventName}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/events/{{eventId}}"
          },
          "response": []
        },
        {
          "name": "PATCH Cancelar evento como organizador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cancela el evento autenticado con HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('El estado final es cancelled', function () { pm.expect(pm.response.json().data.status).to.eql('cancelled'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/events/{{eventId}}/cancel"
          },
