    },
    {
      "key": "categoryId",
      "value": "507f1f77bcf86cd799439011"
    },
    {
      "key": "eventId",
      "value": "507f1f77bcf86cd799439011"
    },
    {
      "key": "registrationId",
      "value": "507f1f77bcf86cd799439011"
    },
    {
      "key": "testEmail",
