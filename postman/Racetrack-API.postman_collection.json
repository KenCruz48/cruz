    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health - 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve estado ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "POST Login - credenciales inválidas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"correo-inexistente@example.com\",\n  \"password\": \"ClaveIncorrecta123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/users/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechaza credenciales inválidas con HTTP 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('La respuesta es JSON', function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Categorías",
      "item": [
        {
          "name": "GET Listar categorías",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/categories?page=1&limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lista categorías con HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('La respuesta incluye datos y paginación', function () { const body = pm.response.json(); pm.expect(body.status).to.eql('success'); pm.expect(body).to.have.property('data'); pm.expect(body).to.have.property('pagination'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Categoría con ID inválido",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/categories/id-invalido"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechaza ID inválido con HTTP 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('La respuesta contiene un mensaje de error', function () { pm.expect(pm.response.json()).to.have.property('message'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Crear categoría",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman RACE45\",\n  \"description\": \"Categoría creada durante pruebas automatizadas\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Crea categoría o informa duplicado', function () { pm.expect([201, 409]).to.include(pm.response.code); });",
                  "if (pm.response.code === 201) { const body = pm.response.json(); pm.test('Devuelve la categoría creada', function () { pm.expect(body.status).to.eql('success'); pm.expect(body.data.name).to.eql('Postman RACE45'); }); if (body.data && body.data._id) { pm.collectionVariables.set('categoryId', body.data._id); } }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Consultar categoría guardada",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Consulta categoría existente', function () { pm.expect([200, 404]).to.include(pm.response.code); });",
                  "if (pm.response.code === 200) { pm.test('Devuelve una categoría', function () { pm.expect(pm.response.json().data).to.be.an('object'); }); }"
                ]
              }
            }
          ]
        }
      ]
    },
