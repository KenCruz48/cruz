  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="RACE-50 - API privada Racetrack">
      <stringProp name="TestPlan.comments">Escenarios reproducibles de carga y estrés sobre cinco rutas protegidas. El setup inicia sesión y crea una categoría desechable.</stringProp>
