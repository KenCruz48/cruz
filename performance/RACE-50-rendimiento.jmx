          <hashTree/>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extraer categoría de JSON" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">categoryId</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.data._id</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">MISSING</stringProp>
          </JSONPostProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Validar y compartir ID de categoría" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def responseCode = prev.getResponseCode()
if (!prev.isSuccessful() || responseCode != &apos;201&apos;) throw new IllegalStateException(&quot;Crear categoría falló: HTTP ${responseCode} ${prev.getResponseMessage()}&quot;)
def categoryId = vars.get(&apos;categoryId&apos;)
if (!categoryId || categoryId == &apos;MISSING&apos;) throw new IllegalStateException(&apos;Crear categoría respondió HTTP 201 pero no devolvió data._id&apos;)
props.put(&apos;qa.categoryId&apos;, categoryId)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>
