            <connectTime>true</connectTime>
          </value>
        </objProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="TestPlan.comments">Inspeccionar las respuestas HTTP y diagnosticar errores en la prueba de carga RACE-50.</stringProp>
      </ResultCollector>
