# Puerto HTTP (opcional; por defecto 3000).
PORT=3000

# Obligatoria: coloca tu URI de MongoDB Atlas solo en .env local.
# Se deja vacía para evitar incluir credenciales o una URI real.
MONGODB_URI=

# Opcional: nombre explicito de BD; si esta vacio se conserva el de la URI.
MONGODB_DB=

# Generar localmente un secreto aleatorio de al menos 32 bytes; nunca publicarlo.
JWT_SECRET=
JWT_EXPIRES_IN=1h
